set(GETT1_ARTWORK_PATH "" CACHE PATH "Optional directory of original licensed PNG and JPG files")
function(panner_artwork target texture_dir font_dir)
    set(files anime.png beach.png cosmic.png graffiti.png screw.png tree.png
        wood_beach.jpg wood_cosmic.jpg wood_garage.jpg wood_kawaii.jpg wood_vintage.jpg)
    set(artwork "${CMAKE_CURRENT_SOURCE_DIR}/${texture_dir}")
    if(GETT1_ARTWORK_PATH)
        set(artwork "${GETT1_ARTWORK_PATH}")
    endif()
    set(resources "${font_dir}/PixelifySans.ttf")
    foreach(file IN LISTS files)
        list(APPEND resources "${artwork}/${file}")
    endforeach()
    juce_add_binary_data(${target} SOURCES ${resources})
endfunction()
