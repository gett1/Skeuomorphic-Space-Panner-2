option(GETT1_BUILD_DSP_TESTS "Build the processor regression checks" OFF)
set(GETT1_LEGACY_SOURCE_DIR "" CACHE PATH "Optional 1.1.0 checkout root for audio regression and benchmarks")

macro(panner_add_dsp_tests plugin)
    if(GETT1_BUILD_DSP_TESTS)
        enable_testing()
        set(panner_tests_dir "${CMAKE_CURRENT_SOURCE_DIR}/../Tests")
        add_executable(PannerDspTests "${panner_tests_dir}/DspTests.cpp")
        target_link_libraries(PannerDspTests PRIVATE ${plugin})
        target_include_directories(PannerDspTests PRIVATE
            "${panner_tests_dir}/../Source"
            "$<TARGET_PROPERTY:${plugin},INCLUDE_DIRECTORIES>")
        if(GETT1_LEGACY_SOURCE_DIR)
            set(legacy_src "${GETT1_LEGACY_SOURCE_DIR}/macos/Source")
            set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
                "${legacy_src}/PluginProcessor.h" "${legacy_src}/PluginProcessor.cpp")
            file(READ "${legacy_src}/PluginProcessor.h" legacy_header)
            file(READ "${legacy_src}/PluginProcessor.cpp" legacy_cpp)
            # Build the original DSP verbatim in this executable, excluding its unused editor and factory.
            string(REPLACE "GettoneSpacePannerProcessor" "LegacyProcessor" legacy_header "${legacy_header}")
            string(REPLACE "GettoneSpacePannerProcessor" "LegacyProcessor" legacy_cpp "${legacy_cpp}")
            string(REPLACE "PluginProcessor.h" "LegacyProcessor.h" legacy_cpp "${legacy_cpp}")
            string(REPLACE "#include \"PluginEditor.h\"" "" legacy_cpp "${legacy_cpp}")
            string(REPLACE "return new GettoneSpacePannerEditor(*this);" "return nullptr;" legacy_cpp "${legacy_cpp}")
            string(REGEX REPLACE "juce::AudioProcessor\\* JUCE_CALLTYPE createPluginFilter.*" "" legacy_cpp "${legacy_cpp}")
            file(CONFIGURE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/LegacyProcessor.h" CONTENT "${legacy_header}" @ONLY)
            file(CONFIGURE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/LegacyProcessor.cpp" CONTENT "${legacy_cpp}" @ONLY)
            target_sources(PannerDspTests PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/LegacyProcessor.cpp")
            target_include_directories(PannerDspTests PRIVATE "${CMAKE_CURRENT_BINARY_DIR}")
            target_compile_definitions(PannerDspTests PRIVATE GETT1_TEST_LEGACY_REFERENCE=1)
        endif()
        add_test(NAME PannerDspTests COMMAND PannerDspTests)
    endif()
endmacro()
